[Unit]
Description=TunnelPilot FastAPI Control Plane
After=network.target network-online.target tunnelpilot-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=tunnelpilot
Group=tunnelpilot
WorkingDirectory=/opt/tunnelpilot

# Security sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/opt/tunnelpilot/server/data

# Environment configuration
EnvironmentFile=-/etc/tunnelpilot/control-plane.env
Environment=TUNNELPILOT_ENVIRONMENT=production
Environment=TUNNELPILOT_DATABASE_PATH=/opt/tunnelpilot/server/data/tunnelpilot.db

ExecStart=/opt/tunnelpilot/.venv/bin/uvicorn server.app.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips='*'

Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
