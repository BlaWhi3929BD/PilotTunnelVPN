# TunnelPilot Release Signing Configuration Template
# DO NOT COMMIT REAL PASSWORDS OR KEYSTORES TO GIT!
# Copy this file to `keystore.properties` and fill in your private credentials.

storeFile=/path/to/your/tunnelpilot-release.jks
storePassword=YourKeystorePasswordHere
keyAlias=tunnelpilot
keyPassword=YourKeyPasswordHere
